# Modelo permitido por el reto (ver CLAUDE.md regla 4): de los cuatro de la
# lista cerrada, Gemini 1.5 Flash (404, retirado) y el Llama 3.1 70B
# original de Groq (descontinuado) ya no son opciones reales — verificado
# contra la API en vivo, no contra documentación. Excepción documentada
# (docs/DECISIONS.md, decisión 10, 2026-08-09, comunicación oficial de
# Source Meridian): un modelo descontinuado se sustituye por el sucesor
# vigente del MISMO proveedor. Esta entrega usa Llama 3.3 70B vía Groq --
# sucesor directo de Llama 3.1 70B, verificado en vivo contra la API de
# Groq el 2026-08-09. Todo lo específico del proveedor vive detrás del
# adaptador en src/llm.js.

PORT=3000

# Proveedor activo de esta entrega: Groq, nube, nivel gratuito. P50 0.685s /
# P95 0.756s medido contra el servidor real (decisión 10) -- compatible con
# conversación de voz en vivo, muy por debajo de los 60.8s/95.3s que medía
# Ollama local. Requiere una GROQ_API_KEY (gratis en console.groq.com) --
# ver README, "Cómo correrlo", para cómo conseguirla dentro de los 15
# minutos de la compuerta G2.
# Riesgo conocido y declarado (decisión 10): el nivel gratuito limita a
# 12.000 tokens/minuto -- varias llamadas de prueba seguidas y rápidas
# pueden chocar contra ese límite. El sistema no se cae: degrada al diálogo
# guionado igual que ante cualquier otro fallo del proveedor.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Opcionales: solo hace falta tocarlos para apuntar a otro endpoint o alias
# de modelo compatible con la API de Groq. Por defecto:
#   GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_URL=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternativa sin llave ni costo, 100% local (docs/DECISIONS.md, decisión
# 5): Llama 3.2 3B vía Ollama. Más lenta (P50 60.8s -- no es "tiempo real"
# para el camino que invoca al modelo) pero no depende de ninguna cuenta ni
# límite de tasa externo. Requiere Ollama instalado y el modelo descargado
# ANTES de arrancar ("ollama pull llama3.2:3b", ~2GB, fuera de los 15
# minutos de G2). Para activarla:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2:3b
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b

# Alternativa medida y documentada (docs/DECISIONS.md, decisión 5): Phi-3.5
# Mini, también local vía Ollama. Más rápida en mediana pero con el doble de
# dispersión que Llama 3.2 3B -- la rúbrica pide P95, no solo mediana. Para
# probarla: ollama pull phi3.5 y LLM_MODEL=phi3.5 (con LLM_PROVIDER=ollama).

# Opcional: solo hace falta tocarlo si Ollama corre en otro host/puerto (por
# ejemplo, en un contenedor separado). Por defecto:
#   OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_API_URL=

# Para desarrollo 100% local sin ni siquiera Ollama corriendo, y sin costo,
# usa LLM_PROVIDER=none: corre completo con el diálogo guionado y la
# recuperación local. Útil mientras se construyen otras partes del sistema.
# LLM_PROVIDER=none

# Retrieval mode: local = TF-IDF, no embeddings, no cost.
#                 embeddings = requires EMBEDDINGS_* below.
RETRIEVAL_MODE=local
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
