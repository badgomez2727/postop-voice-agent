# Modelo permitido por el reto (ver CLAUDE.md): Groq con Llama 3.1 70B.
# Todo lo específico del proveedor vive detrás del adaptador en src/llm.js.

PORT=3000

# Modo por defecto documentado de esta entrega. Necesita GROQ_API_KEY.
# → https://console.groq.com/keys
# Si la llamada a Groq falla (red caída, límite de tasa, llave inválida o
# ausente) el sistema degrada automáticamente al diálogo guionado (motor
# "scripted-fallback") y la llamada telefónica no se interrumpe.
LLM_PROVIDER=groq
GROQ_API_KEY=

# Opcionales: solo hace falta tocarlos para apuntar a otro endpoint o alias
# de modelo compatible con la API de Groq. Por defecto:
#   GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
#   GROQ_MODEL=llama-3.1-70b-versatile
GROQ_API_URL=
GROQ_MODEL=

# Para desarrollo 100% local, sin llamar a ningún proveedor y sin costo,
# usa LLM_PROVIDER=none: corre completo con el diálogo guionado y la
# recuperación local. Útil mientras se construyen otras partes del sistema.
# LLM_PROVIDER=none

# Retrieval mode: local = TF-IDF, no embeddings, no cost.
#                 embeddings = requires EMBEDDINGS_* below.
RETRIEVAL_MODE=local
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
