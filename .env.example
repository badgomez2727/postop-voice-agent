# Modelo permitido por el reto (ver CLAUDE.md): de los cuatro de la lista
# cerrada, Gemini 1.5 Flash (404, retirado) y Groq con Llama 3.1 70B
# (descontinuado) ya no son opciones reales — verificado contra la API en
# vivo, no contra documentación. Esta entrega usa Llama 3.2 3B local vía
# Ollama. Razonamiento completo y mediciones en docs/DECISIONS.md, decisión
# 5. Todo lo específico del proveedor vive detrás del adaptador en
# src/llm.js.

PORT=3000

# Modo por defecto de esta entrega: Ollama corriendo local, sin llave ni
# costo. Requiere tener Ollama instalado y el modelo descargado ANTES de
# arrancar (ver README, sección "Cómo correrlo") — "ollama pull llama3.2:3b"
# baja ~2GB, así que ese paso queda fuera de los 15 minutos de la compuerta
# G2, no dentro.
# Si Ollama no responde (no está corriendo, o el modelo no se descargó) el
# sistema degrada automáticamente al diálogo guionado (motor
# "scripted-fallback"), la llamada telefónica no se interrumpe, y queda una
# advertencia visible en la consola del servidor — no solo en el registro.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Alternativa medida y documentada (docs/DECISIONS.md, decisión 5): Phi-3.5
# Mini. Más rápida en mediana pero con el doble de dispersión que Llama 3.2
# 3B — la rúbrica pide P95, no solo mediana. Para probarla, sin tocar código:
#   ollama pull phi3.5
#   LLM_MODEL=phi3.5
# LLM_MODEL=phi3.5

# Opcional: solo hace falta tocarlo si Ollama corre en otro host/puerto (por
# ejemplo, en un contenedor separado). Por defecto:
#   OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_API_URL=

# Para desarrollo 100% local sin ni siquiera Ollama corriendo, y sin costo,
# usa LLM_PROVIDER=none: corre completo con el diálogo guionado y la
# recuperación local. Útil mientras se construyen otras partes del sistema.
# LLM_PROVIDER=none

# Groq con Llama 3.1 70B (nube, nivel gratuito) y Gemini 1.5 Flash siguen
# siendo modelos permitidos por la lista cerrada del reto si alguno vuelve a
# estar disponible — ver docs/DECISIONS.md, decisión 5, para por qué no son
# la decisión activa hoy. El código de Groq sigue funcionando en src/llm.js;
# Gemini no está implementado.
# LLM_PROVIDER=groq
GROQ_API_KEY=

# Opcionales: solo hace falta tocarlos para apuntar a otro endpoint o alias
# de modelo compatible con la API de Groq. Por defecto:
#   GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
#   GROQ_MODEL=llama-3.1-70b-versatile
GROQ_API_URL=
GROQ_MODEL=

# Retrieval mode: local = TF-IDF, no embeddings, no cost.
#                 embeddings = requires EMBEDDINGS_* below.
RETRIEVAL_MODE=local
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
