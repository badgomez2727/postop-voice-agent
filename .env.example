# The mandatory model for the challenge is announced on August 7.
# This project keeps the LLM behind an adapter (src/llm.js) so only these
# values change when the model is announced.

PORT=3000

# Leave LLM_PROVIDER=none to run fully offline with the rule-based dialogue
# engine and local retrieval. No API costs while you build the scaffolding.
LLM_PROVIDER=none

LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval mode: local = TF-IDF, no embeddings, no cost.
#                 embeddings = requires EMBEDDINGS_* below.
RETRIEVAL_MODE=local
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
